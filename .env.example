# =============================================================================
# Salin file ini menjadi .env lalu isi nilainya
# Di Dokploy: tab Environment → paste isi ini → isi nilainya
# =============================================================================

# [WAJIB] Domain — sesuai yang didaftarkan di tab Domains Dokploy
PAPERCLIP_PUBLIC_URL=https://workspace.elshobah.com
PAPERCLIP_AUTH_PUBLIC_BASE_URL=https://workspace.elshobah.com
PAPERCLIP_ALLOWED_HOSTNAMES=workspace.elshobah.com

# [WAJIB] Auth secret — generate: openssl rand -hex 32
BETTER_AUTH_SECRET=

# [WAJIB] PostgreSQL password — generate: openssl rand -hex 16
POSTGRES_PASSWORD=

# [WAJIB] Redis password — generate: openssl rand -hex 16
REDIS_PASSWORD=

# [OPSIONAL] Bootstrap CEO — auto-create admin pertama saat startup
PAPERCLIP_BOOTSTRAP_CEO_EMAIL=
PAPERCLIP_BOOTSTRAP_CEO_PASSWORD=

# [WAJIB] Anthropic API Key
ANTHROPIC_API_KEY=

# [OPSIONAL] OpenAI (jika ada agent yang pakai GPT/Codex)
OPENAI_API_KEY=

# [OPSIONAL] Log level: error | warn | info | debug
LOG_LEVEL=info
